{
  "name": "leaderm-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "php -S 127.0.0.1:8080 api/router-dev.php",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && tsx scripts/prerender.ts",
    "test": "vitest run",
    "test:php": "php tests/php/run.php",
    "typecheck": "tsc --noEmit",
    "images": "tsx scripts/images.ts && tsx scripts/og.ts",
    "favicons": "tsx scripts/favicons.ts",
    "release": "npm run build && tsx scripts/release.ts"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "less": "^4.9.1",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
